# Copie este arquivo para ".env.local" e preencha com os dados do seu projeto Supabase
# (Supabase > Project Settings > API). Estas duas são públicas por natureza:
# a proteção real são as regras de segurança do banco.
# NUNCA coloque aqui a chave "secret" / "service_role".
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx
